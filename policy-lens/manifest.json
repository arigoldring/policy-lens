{
  "manifest_version": 3,
  "name": "Policy Lens (Basic)",
  "version": "0.0.1",
  "description": "Basic starting point for Policy Lens extension.",
  "icons": {
    "48": "triangle.jpg",
    "128": "triangle.jpg"
  },
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}